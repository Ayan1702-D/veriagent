# Environment: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite for local dev, PostgreSQL URL for prod)
DATABASE_URL=sqlite:///./veriagent.db

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# LLM Provider API Keys (placeholders only - never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Routing (LiteLLM format)
CHEAP_MODEL=gemini/gemini-1.5-flash
STRONG_MODEL=gemini/gemini-1.5-pro

# Optional Search API Keys
TAVILY_API_KEY=
OPENALEX_MAILTO=you@example.com

# Default Run Budget Caps
MAX_LLM_TOKENS=12000
MAX_SEARCHES=6
MAX_FETCHES=10
MAX_LOOPS=2
MAX_SECONDS=60

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000