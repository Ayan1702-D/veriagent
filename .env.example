# Environment: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite for local dev, PostgreSQL URL for prod)
DATABASE_URL=sqlite:///./veriagent.db

# CORS
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
DEMO_REPLAY_ENABLED=true

# Curated corpus (FastEmbed + local ChromaDB)
CORPUS_ENABLED=true
CORPUS_DIR=corpus
CHROMA_PATH=chroma_data
CORPUS_COLLECTION=veriagent_corpus
CORPUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CORPUS_MAX_DOCUMENT_BYTES=10485760
CORPUS_CHUNK_SIZE=1200
CORPUS_CHUNK_OVERLAP=200
CORPUS_TOP_K=3

# LLM Provider API Keys (placeholders only - never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Routing (LiteLLM format)
CHEAP_MODEL=gemini/gemini-1.5-flash
STRONG_MODEL=gemini/gemini-1.5-pro

# Optional Search API Keys
TAVILY_API_KEY=
OPENALEX_MAILTO=you@example.com

# Default Run Budget Caps
MAX_LLM_TOKENS=6000
MAX_SEARCHES=4
MAX_FETCHES=6
MAX_LOOPS=1
MAX_SECONDS=45

# Evaluation regression gate (maximum accepted regression)
EVAL_REGRESSION_TOLERANCE=0.02

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
